{
  "name": "@lapointelabs/tripwire",
  "version": "0.1.1-rc.0",
  "description": "Security scan for Claude Code, Cursor, and coding agents — injection sinks, secrets, prompt-injection surfaces, and repo lies that mislead LLMs.",
  "type": "module",
  "bin": {
    "tripwire": "bin/tripwire.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check bin/tripwire.js",
    "release:check": "npm test && npm publish --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=20.1"
  },
  "keywords": [
    "agents",
    "claude",
    "claude-code",
    "cli",
    "code-scanning",
    "coding-agents",
    "cursor",
    "llm",
    "monorepo",
    "prompt-injection",
    "sast",
    "security",
    "security-scan",
    "sql-injection",
    "static-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapointelabs/tripwire.git"
  },
  "homepage": "https://github.com/lapointelabs/tripwire#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "ollama": "^0.6.3",
    "openai": "^7.4.0"
  },
  "peerDependencies": {
    "@cursor/sdk": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@cursor/sdk": {
      "optional": true
    }
  }
}
